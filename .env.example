# ==============================================================
# GovDesk — Konfiguration
# Alle Werte können auch über Umgebungsvariablen gesetzt werden.
# Verbindungen zu Ollama/Modellen werden zusätzlich über den
# Einrichtungs-Wizard bzw. /admin/settings gepflegt (app_settings).
# ==============================================================

# Pflicht: geheimer Schlüssel zum Signieren von Cookies.
# Erzeugen mit:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
GOVDESK_SECRET_KEY=bitte-aendern

# PostgreSQL (im Compose-Stack: Host "postgres")
GOVDESK_DATABASE_URL=postgresql+psycopg://govdesk:govdesk@localhost:5432/govdesk

# Qdrant (im Compose-Stack: Host "qdrant")
GOVDESK_QDRANT_URL=http://localhost:6333

# Ollama — lokal oder Cloud (https://ollama.com mit API-Key)
GOVDESK_OLLAMA_BASE_URL=http://localhost:11434
#GOVDESK_OLLAMA_API_KEY=

# Reranker (Text-Embeddings-Inference mit bge-reranker-v2-m3)
GOVDESK_RERANKER_URL=http://localhost:8081

# Standard-Modelle (Initialwerte; im Wizard änderbar)
GOVDESK_DEFAULT_LLM_MODEL=gemma3:4b
GOVDESK_EMBEDDING_MODEL=bge-m3

# Datei-Ablage für hochgeladene Dokumente
GOVDESK_DATA_DIR=./data

# Cookies nur über HTTPS ausliefern (hinter TLS-Proxy: true)
GOVDESK_COOKIE_SECURE=false

# Optional: Keycloak / OIDC
GOVDESK_OIDC_ENABLED=false
#GOVDESK_OIDC_ISSUER=https://keycloak.example.de/realms/govdesk
#GOVDESK_OIDC_CLIENT_ID=govdesk
#GOVDESK_OIDC_CLIENT_SECRET=
#GOVDESK_LOCAL_LOGIN_ENABLED=true

# Optional: Konvertierung von Legacy-.doc via LibreOffice (vergrößert das Image)
GOVDESK_ENABLE_DOC_CONVERT=false
